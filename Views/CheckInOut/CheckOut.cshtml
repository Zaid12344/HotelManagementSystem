@model HotelManagement.Models.ViewModels.CheckOutViewModel
@{
    ViewData["Title"] = "Check-Out";
}

<h2>🏁 Check-Out — @Model.BookingReference</h2>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header"><strong>Guest & Stay</strong></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Guest</dt>
                    <dd class="col-sm-8">@Model.GuestName</dd>
                    <dt class="col-sm-4">Folio</dt>
                    <dd class="col-sm-8">@Model.FolioNumber</dd>
                    <dt class="col-sm-4">Stay</dt>
                    <dd class="col-sm-8">
                        @Model.CheckInDate.ToString("dd MMM") → @Model.CheckOutDate.ToString("dd MMM yyyy")
                        (@Model.Nights night(s))
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header"><strong>Bill Summary</strong></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-6">Total Charges</dt>
                    <dd class="col-sm-6 text-end">₹@Model.TotalCharges.ToString("N0")</dd>

                    <dt class="col-sm-6">Amount Paid</dt>
                    <dd class="col-sm-6 text-end">₹@Model.TotalPaid.ToString("N0")</dd>

                    <dt class="col-sm-6 fw-bold">Balance Due</dt>
                    <dd class="col-sm-6 text-end fw-bold text-danger">₹@Model.Balance.ToString("N0")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header"><strong>Folio Lines</strong></div>
    <div class="card-body p-0">
        <table class="table mb-0">
            <thead class="table-light">
                <tr><th>When</th><th>Type</th><th>Description</th><th class="text-end">Amount</th></tr>
            </thead>
            <tbody>
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td>@line.PostedAt.ToString("dd MMM HH:mm")</td>
                        <td>@line.LineType</td>
                        <td>@line.Description</td>
                        <td class="text-end">₹@line.Amount.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>📑 Folio @Model.FolioNumber</h2>
    <div>
        <a asp-controller="Billing" asp-action="InvoicePdf" asp-route-id="@Model.Id"
           class="btn btn-primary" target="_blank">📄 Download Invoice</a>
        @if (Model.Balance > 0)
        {
            <a asp-controller="Billing" asp-action="Pay" asp-route-id="@Model.Id"
               class="btn btn-success">💳 Record Payment</a>
            <a asp-controller="Billing" asp-action="Split" asp-route-id="@Model.Id"
               class="btn btn-outline-primary">🪓 Split</a>
        }
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </div>
</div>
<form asp-action="CheckOutConfirmed" method="post"
      onsubmit="return confirm('Confirm check-out? Rooms will be marked for cleaning.');">
    @Html.AntiForgeryToken()
    <input type="hidden" name="reservationId" value="@Model.ReservationId" />

    @if (Model.Balance > 0)
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="allowUnpaid"
                           name="allowUnpaid" value="true" />
                    <label class="form-check-label" for="allowUnpaid">
                        Check out with unpaid balance (override)
                    </label>
                </div>
                <div class="mt-2">
                    <input type="text" name="overrideReason" class="form-control"
                           placeholder="Reason (required if overriding)" />
                </div>
            </div>
        </div>
    }

    <button type="submit" class="btn btn-warning">Confirm Check-Out</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

