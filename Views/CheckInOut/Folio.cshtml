@model HotelManagement.Models.ViewModels.FolioDetailsViewModel
@{
    ViewData["Title"] = "Folio";
}
@using HotelManagement.Models.Helpers


<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>📑 Folio @Model.FolioNumber</h2>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header"><strong>Guest</strong></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8">@Model.GuestName</dd>
                    <dt class="col-sm-4">Phone</dt>
                    <dd class="col-sm-8">@Model.GuestPhone</dd>
                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.GuestEmail</dd>
                    <dt class="col-sm-4">Booking</dt>
                    <dd class="col-sm-8">@Model.BookingReference</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header"><strong>Folio</strong></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8"><span class="badge-status badge-status-info">@Model.Status</span></dd>
                    <dt class="col-sm-4">Opened</dt>
                    <dd class="col-sm-8">@Model.OpenedAt.ToString("dd MMM yyyy HH:mm")</dd>
                    @if (Model.ClosedAt.HasValue)
                    {
                        <dt class="col-sm-4">Closed</dt>
                        <dd class="col-sm-8">@Model.ClosedAt.Value.ToString("dd MMM yyyy HH:mm")</dd>
                    }
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header"><strong>Charges</strong></div>
    <div class="card-body p-0">
        <table class="table mb-0">
            <thead class="table-light">
                <tr><th>When</th><th>Type</th><th>Description</th><th class="text-end">Amount</th></tr>
            </thead>
            <tbody>
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td>@line.PostedAt.ToString("dd MMM HH:mm")</td>
                        <td>@line.LineType</td>
                        <td>@line.Description</td>
                        <td class="text-end">₹@line.Amount.ToString("N0")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Total Charges</th>
                    <th class="text-end">₹@Model.TotalCharges.ToString("N0")</th>
                </tr>
                <tr>
                    <th colspan="3" class="text-end">Total Paid</th>
                    <th class="text-end">₹@Model.TotalPaid.ToString("N0")</th>
                </tr>
                <tr class="table-warning">
                    <th colspan="3" class="text-end">Balance</th>
                    <th class="text-end">₹@Model.Balance.ToString("N0")</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>