@model List<HotelManagement.Models.ViewModels.UserListViewModel>
@{ ViewData["Title"] = "User Management"; }
@using HotelManagement.Models.Helpers

<partial name="_Alerts" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>👥 User Management</h2>
    <a asp-action="Create" class="btn btn-success">+ New User</a>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body">
            <partial name="_EmptyState"
            model="@((
                         "👥",
                         "No users yet",
                         "Create staff accounts with appropriate roles to get started.",
                         "+ New User",
                         Url.Action("Create", "Users")!
                     ))" />
        </div>
    </div>
}
else
{
    <table class="table table-hover">
        <thead class="table-light">
            <tr>
                <th>Full Name</th>
                <th>Email</th>
                <th>Roles</th>
                <th>Status</th>
                <th>Created</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td>@string.Join(", ", user.Roles)</td>
                    <td>
                       <span class="@BadgeHelper.Active(user.IsActive)">@(user.IsActive ? "Active" : "Inactive")</span>
                    </td>
                    <td>@user.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                    <td>
                        <form asp-action="ToggleActive" asp-route-id="@user.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                @(user.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}