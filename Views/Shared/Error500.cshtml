@{ ViewData["Title"] = "Something Went Wrong"; Layout = "~/Views/Shared/_Layout.cshtml"; }

<div class="text-center py-5">
    <div style="font-size:5rem;">⚠️</div>
    <h1 class="mt-2">500 — Something Went Wrong</h1>
    <p class="text-muted">An unexpected error occurred. Our team has been notified.</p>
    @if (ViewBag.ErrorId != null)
    {
        <p class="small text-muted">Reference ID: <code>@ViewBag.ErrorId</code></p>
    }
    <div class="mt-3">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Go to Dashboard</a>
        <a href="javascript:history.back()" class="btn btn-secondary">Go Back</a>
    </div>
</div>