@{ ViewData["Title"] = "Page Not Found"; Layout = "~/Views/Shared/_Layout.cshtml"; }

<div class="text-center py-5">
    <div style="font-size:5rem;">🔍</div>
    <h1 class="mt-2">404 — Page Not Found</h1>
    <p class="text-muted">The page you're looking for doesn't exist or has moved.</p>
    <div class="mt-3">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Go to Dashboard</a>
        <a href="javascript:history.back()" class="btn btn-secondary">Go Back</a>
    </div>
</div>