@model List<HotelManagement.Models.ViewModels.ServiceListViewModel>
@{ ViewData["Title"] = "Service Catalog"; }
@using HotelManagement.Models.Helpers

<partial name="_Alerts" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>🛎️ Service Catalog</h2>
    <div>
        <a asp-action="Requests" class="btn btn-outline-primary">Service Requests</a>
        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <a asp-action="Create" class="btn btn-success">+ New Service</a>
        }
    </div>
</div>


@if (!Model.Any())
{
    <div class="card">
        <div class="card-body">
            <partial name="_EmptyState"
            model="@((
                         "🛎️",
                         "No services yet",
                         "Add services like laundry, spa, or airport pickup for guests to book.",
                         "+ New Service",
                         Url.Action("Create", "Service")!
                     ))" />
        </div>
    </div>
}
else
{

    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Name</th><th>Category</th><th>Price</th><th>Status</th><th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>
                        <strong>@s.Name</strong><br />
                        <small class="text-muted">@s.Description</small>
                    </td>
                    <td>@s.Category</td>
                    <td>₹@s.Price.ToString("N0")</td>
                    <td>
                        <span class="@BadgeHelper.Active(s.IsActive)">@(s.IsActive ? "Active" : "Inactive")</span>
                    </td>
                    <td class="text-end">
                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <form asp-action="ToggleActive" asp-route-id="@s.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm @(s.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                    @(s.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}