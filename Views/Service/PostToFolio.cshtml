@model HotelManagement.Models.ViewModels.PostServiceViewModel
@{ ViewData["Title"] = "Post Service to Folio"; }

<h2>🛎️ Post Service Charge — @Model.BookingReference</h2>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Guest</dt><dd class="col-sm-8">@Model.GuestName</dd>
                    <dt class="col-sm-4">Room</dt><dd class="col-sm-8">@Model.RoomNumber</dd>
                </dl>
            </div>
        </div>

        <form asp-action="PostToFolio" method="post">
            <input type="hidden" asp-for="ReservationId" />
            <input type="hidden" asp-for="RoomId" />

            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="ServiceId" class="form-label"></label>
                <select asp-for="ServiceId" class="form-select">
                    <option value="">-- Select Service --</option>
                    @foreach (var s in Model.AvailableServices)
                    {
                        <option value="@s.Id">@s.Category — @s.Name (₹@s.Price.ToString("N0"))</option>
                    }
                </select>
                <span asp-validation-for="ServiceId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Quantity" class="form-label"></label>
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            </div>

            <button type="submit" class="btn btn-primary">Post to Folio</button>
            <a asp-controller="Reservation" asp-action="Details" asp-route-id="@Model.ReservationId"
               class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }