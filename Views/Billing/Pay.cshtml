@model HotelManagement.Models.ViewModels.PaymentViewModel
@using HotelManagement.Models.Enums
@{
    ViewData["Title"] = "Record Payment";
}

<h2>💳 Record Payment — @Model.FolioNumber</h2>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-6">Guest</dt>
                    <dd class="col-sm-6">@Model.GuestName</dd>
                    <dt class="col-sm-6">Total Charges</dt>
                    <dd class="col-sm-6">₹@Model.TotalCharges.ToString("N2")</dd>
                    <dt class="col-sm-6">Already Paid</dt>
                    <dd class="col-sm-6">₹@Model.TotalPaid.ToString("N2")</dd>
                    <dt class="col-sm-6 fw-bold">Balance Due</dt>
                    <dd class="col-sm-6 fw-bold text-danger">₹@Model.Balance.ToString("N2")</dd>
                </dl>
            </div>
        </div>

        @if (Model.Balance > 0)
        {
            <form asp-action="Pay" method="post">
                <input type="hidden" asp-for="FolioId" />
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Amount" class="form-label"></label>
                    <input asp-for="Amount" class="form-control" />
                    <span asp-validation-for="Amount" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Method" class="form-label"></label>
                    <select asp-for="Method" asp-items="Html.GetEnumSelectList<PaymentMethod>()" class="form-select"></select>
                </div>
                <div class="mb-3">
                    <label asp-for="TransactionReference" class="form-label"></label>
                    <input asp-for="TransactionReference" class="form-control"
                           placeholder="UPI txn / card auth / cheque #" />
                </div>
                <div class="mb-3">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>

                <button type="submit" class="btn btn-success">💾 Record Payment</button>
                <a asp-controller="CheckInOut" asp-action="Folio" asp-route-id="@Model.FolioId"
                   class="btn btn-secondary">Back to Folio</a>
            </form>
        }
        else
        {
            <div class="alert alert-success">✅ Folio is fully paid.</div>
            <a asp-controller="CheckInOut" asp-action="Folio" asp-route-id="@Model.FolioId"
               class="btn btn-secondary">Back to Folio</a>
        }
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header"><strong>Payment History</strong></div>
            <div class="card-body p-0">
                @if (!Model.History.Any())
                {
                     <partial name="_EmptyState"
                     model="@((
                         "💳",
                         "No payments yet",
                         "Record a payment using the form on the left.",
                         (string?)null,
                         (string?)null
                     ))" />
                }
                else
                {
                    <table class="table mb-0">
                        <thead class="table-light">
                            <tr><th>Receipt</th><th>When</th><th>Method</th><th class="text-end">Amount</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.History)
                            {
                                <tr>
                                    <td>@p.ReceiptNumber</td>
                                    <td>@p.PaidAt.ToString("dd MMM HH:mm")</td>
                                    <td>@p.Method</td>
                                    <td class="text-end">₹@p.Amount.ToString("N2")</td>
                                    <td>
                                        <a asp-action="ReceiptPdf" asp-route-id="@p.Id"
                                           class="btn btn-sm btn-outline-secondary" target="_blank">PDF</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}