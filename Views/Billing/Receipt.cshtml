@model HotelManagement.Models.Entities.Payment
@{
    ViewData["Title"] = "Payment Receipt";
}

<h2>🧾 Receipt @Model.ReceiptNumber</h2>

<div class="card" style="max-width:520px;">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Folio</dt>
            <dd class="col-sm-8">@Model.Folio.FolioNumber</dd>
            <dt class="col-sm-4">Guest</dt>
            <dd class="col-sm-8">@Model.Folio.Guest.FullName</dd>
            <dt class="col-sm-4">Amount</dt>
            <dd class="col-sm-8 fw-bold">₹@Model.Amount.ToString("N2")</dd>
            <dt class="col-sm-4">Method</dt>
            <dd class="col-sm-8">@Model.Method</dd>
            @if (!string.IsNullOrEmpty(Model.TransactionReference))
            {
                <dt class="col-sm-4">Reference</dt>
                <dd class="col-sm-8">@Model.TransactionReference</dd>
            }
            <dt class="col-sm-4">Paid At</dt>
            <dd class="col-sm-8">@Model.PaidAt.ToString("dd MMM yyyy HH:mm")</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="ReceiptPdf" asp-route-id="@Model.Id" class="btn btn-primary" target="_blank">📄 Download PDF</a>
    <a asp-controller="CheckInOut" asp-action="Folio" asp-route-id="@Model.FolioId"
       class="btn btn-secondary">Back to Folio</a>
</div>